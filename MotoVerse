
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MotoVerse | Premium Bike Showroom</title>
<meta name="description" content="Discover premium sports bikes, superbikes and street motorcycles at MotoVerse.">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Orbitron:wght@500;600;700;800&display=swap');

:root {
  --bg: #080b10;
  --card: #111720;
  --red: #ff3d3d;
  --white: #f5f7fa;
  --muted: #9ca7b6;
}
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }
body {
  background:var(--bg);
  color:var(--white);
  font-family:Inter,Arial,sans-serif;
}
a { text-decoration:none; color:inherit; }
button,input { font:inherit; }
header {
  display:flex; justify-content:space-between; align-items:center;
  padding:20px 7%; border-bottom:1px solid #ffffff12;
  background:#080b10ee; position:sticky; top:0; z-index:10;
  backdrop-filter:blur(14px);
}
.logo { font:800 23px Orbitron,sans-serif; }
.logo span { color:var(--red); }
nav { display:flex; gap:28px; align-items:center; }
nav a { color:#c2c9d3; font-size:14px; }
nav a:hover { color:var(--red); }
.btn {
  display:inline-block; background:var(--red); color:white;
  border:0; padding:13px 21px; border-radius:6px;
  font-weight:700; cursor:pointer; transition:.2s;
}
.btn:hover { background:#db2929; transform:translateY(-2px); }
.hero {
  min-height:570px; padding:80px 7%;
  display:flex; align-items:center; position:relative; overflow:hidden;
  background:radial-gradient(ellipse at 78% 48%,#521b1d55,transparent 45%);
}
.hero-content { max-width:560px; z-index:1; }
.tag { color:var(--red); font-size:12px; font-weight:800; letter-spacing:3px; }
h1 { font:800 clamp(42px,6vw,76px)/1.12 Orbitron,sans-serif; margin:22px 0; }
h1 span { color:var(--red); }
.hero p { color:var(--muted); line-height:1.8; max-width:480px; }
.hero-actions { display:flex; gap:14px; margin-top:30px; flex-wrap:wrap; }
.btn-outline { border:1px solid #ffffff35; padding:13px 21px; border-radius:6px; }
.hero-image {
  position:absolute; right:2%; width:51%; height:85%;
  object-fit:contain; filter:drop-shadow(0 25px 40px #ff242433);
}
.stats { display:flex; gap:38px; margin-top:48px; }
.stats strong { display:block; font:700 24px Orbitron,sans-serif; }
.stats small { color:var(--muted); display:block; margin-top:7px; }
section { padding:80px 7%; }
.section-head {
  display:flex; justify-content:space-between; align-items:end;
  gap:20px; margin-bottom:32px; flex-wrap:wrap;
}
h2 { font:700 clamp(25px,4vw,37px) Orbitron,sans-serif; margin-top:12px; }
.section-head p { color:var(--muted); margin-top:12px; line-height:1.6; }
.tools { display:flex; gap:10px; flex-wrap:wrap; }
.tools input,.tools select {
  background:#111720; color:white; border:1px solid #ffffff20;
  border-radius:6px; padding:12px; min-width:150px; outline:none;
}
.tools input:focus { border-color:var(--red); }
.bike-grid {
  display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px;
}
.bike-card {
  background:var(--card); border:1px solid #ffffff12;
  border-radius:12px; overflow:hidden; transition:.25s;
}
.bike-card:hover { transform:translateY(-6px); border-color:#ff3d3d80; }
.bike-img { height:225px; background:#171d27; overflow:hidden; }
.bike-img img { width:100%; height:100%; object-fit:cover; transition:.4s; }
.bike-card:hover .bike-img img { transform:scale(1.06); }
.bike-info { padding:22px; }
.category { color:var(--red); font-size:11px; letter-spacing:2px; font-weight:800; }
.bike-info h3 { font-size:21px; margin:10px 0; }
.specs { display:flex; justify-content:space-between; color:var(--muted); font-size:12px; gap:8px; }
.price-row {
  display:flex; justify-content:space-between; align-items:center;
  border-top:1px solid #ffffff12; margin-top:20px; padding-top:18px; gap:8px;
}
.price { font-weight:800; font-size:16px; }
.small-btn { padding:10px 12px; font-size:12px; }
.empty { display:none; color:var(--muted); padding:30px 0; }
.about {
  display:grid; grid-template-columns:1fr 1fr; gap:50px; align-items:center;
  background:#0d121a;
}
.about-image { width:100%; height:350px; object-fit:cover; border-radius:12px; }
.about p { color:var(--muted); line-height:1.9; margin:20px 0; }
.features { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-top:25px; }
.features div { border-left:3px solid var(--red); padding:8px 12px; }
.features strong { display:block; margin-bottom:7px; }
.features small { color:var(--muted); }
.contact {
  text-align:center;
  background:linear-gradient(120deg,#271012,#111720 65%);
}
.contact p { color:var(--muted); margin:18px auto 28px; line-height:1.8; }
footer {
  padding:28px 7%; display:flex; justify-content:space-between;
  flex-wrap:wrap; gap:15px; color:var(--muted); font-size:13px;
  border-top:1px solid #ffffff12;
}
@media(max-width:900px) {
  .hero-image { opacity:.25; width:75%; right:-15%; }
  .bike-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media(max-width:600px) {
  header { padding:18px 5%; }
  nav { gap:12px; }
  nav a { font-size:12px; }
  nav .nav-contact { display:none; }
  .logo { font-size:17px; }
  .hero { padding:65px 5%; min-height:540px; }
  .hero-image { width:110%; right:-35%; opacity:.17; }
  section { padding:60px 5%; }
  .bike-grid,.about { grid-template-columns:1fr; }
  .bike-img { height:230px; }
  .stats { gap:22px; }
  .stats strong { font-size:19px; }
  .tools { width:100%; }
  .tools input,.tools select { flex:1; min-width:0; width:100%; }
  .about-image { height:250px; }
}
</style>
</head>
<body>

<header>
  <a class="logo" href="#home">MOTO<span>VERSE</span></a>
  <nav>
    <a href="#home">Home</a>
    <a href="#bikes">Bikes</a>
    <a href="#about">About</a>
    <a class="nav-contact" href="#contact">Contact</a>
  </nav>
</header>

<main>
<section class="hero" id="home">
  <div class="hero-content">
    <div class="tag">PREMIUM MOTORCYCLE SHOWROOM</div>
    <h1>RIDE YOUR<br><span>OWN LEGEND.</span></h1>
    <p>Discover powerful machines, iconic designs and the thrill of the open road. Your next ride starts here.</p>
    <div class="hero-actions">
      <a href="#bikes" class="btn">Explore Bikes ↗</a>
      <a href="#about" class="btn-outline">Discover MotoVerse</a>
    </div>
    <div class="stats">
      <div><strong>20+</strong><small>Bike Models</small></div>
      <div><strong>500+</strong><small>Happy Riders</small></div>
      <div><strong>100%</strong><small>Passion</small></div>
    </div>
  </div>
  <img class="hero-image"
    src="https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=1100&q=85"
    alt="Premium motorcycle" onerror="this.style.display='none'">
</section>

<section id="bikes">
  <div class="section-head">
    <div>
      <div class="tag">FIND YOUR MACHINE</div>
      <h2>FEATURED BIKES</h2>
      <p>Explore our handpicked collection of motorcycles.</p>
    </div>
    <div class="tools">
      <input id="search" type="search" placeholder="Search bikes..." aria-label="Search bikes">
      <select id="filter" aria-label="Filter bikes by category">
        <option value="all">All Categories</option>
        <option value="Sports">Sports</option>
        <option value="Street">Street</option>
        <option value="Adventure">Adventure</option>
        <option value="Cruiser">Cruiser</option>
      </select>
    </div>
  </div>

  <div class="bike-grid" id="bikeGrid"></div>
  <p class="empty" id="empty">No bikes found. Try another search.</p>
</section>

<section class="about" id="about">
  <div>
    <img class="about-image"
      src="https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=1000&q=85"
      alt="Motorcycle adventure">
  </div>
  <div>
    <div class="tag">WHO WE ARE</div>
    <h2>MORE THAN A SHOWROOM.</h2>
    <p>MotoVerse is built for people who live for the ride. Explore different motorcycle styles, compare features and find the machine that matches your journey.</p>
    <div class="features">
      <div><strong>✓ Quality First</strong><small>Carefully selected bikes</small></div>
      <div><strong>✓ Expert Support</strong><small>Help choosing your ride</small></div>
      <div><strong>✓ Easy Enquiries</strong><small>Contact us about a model</small></div>
      <div><strong>✓ Rider Focused</strong><small>Made for bike lovers</small></div>
    </div>
  </div>
</section>

<section class="contact" id="contact">
  <div class="tag">YOUR NEXT ADVENTURE</div>
  <h2>READY TO RIDE?</h2>
  <p>Found a bike you love? Get in touch with our showroom to ask about<br> availability, current prices and test rides.</p>
  <a class="btn" id="contactBtn" href="https://wa.me/" target="_blank" rel="noopener">Contact Showroom ↗</a>
</section>
</main>

<footer>
  <a class="logo" href="#home">MOTO<span>VERSE</span></a>
  <p>© <span id="year"></span> MotoVerse. Ride with passion.</p>
  <a href="#home">Back to top ↑</a>
</footer>

<script>
const bikes = [
  {
    name:"Yamaha YZF-R1", category:"Sports",
    price:"PKR 2,500,000",
    engine:"998cc", type:"Superbike",
    image:"https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=700&q=80"
  },
  {
    name:"Kawasaki Ninja", category:"Sports",
    price:"PKR 1,800,000",
    engine:"650cc", type:"Sport",
    image:"https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?auto=format&fit=crop&w=700&q=80"
  },
  {
    name:"Honda CB Series", category:"Street",
    price:"PKR 950,000",
    engine:"500cc", type:"Street",
    image:"https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=700&q=80"
  },
  {
    name:"BMW Adventure", category:"Adventure",
    price:"PKR 3,200,000",
    engine:"850cc", type:"Adventure",
    image:"https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=700&q=80"
  },
  {
    name:"Royal Enfield", category:"Cruiser",
    price:"PKR 1,200,000",
    engine:"650cc", type:"Classic",
    image:"https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=700&q=80"
  },
  {
    name:"KTM Duke", category:"Street",
    price:"PKR 1,050,000",
    engine:"390cc", type:"Naked",
    image:"https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?auto=format&fit=crop&w=700&q=80"
  }
];

const grid = document.getElementById("bikeGrid");
const search = document.getElementById("search");
const filter = document.getElementById("filter");

function renderBikes() {
  const query = search.value.trim().toLowerCase();
  const category = filter.value;

  const results = bikes.filter(bike =>
    (bike.name.toLowerCase().includes(query) ||
     bike.category.toLowerCase().includes(query)) &&
    (category === "all" || bike.category === category)
  );

  grid.innerHTML = results.map(bike => `
    <article class="bike-card">
      <div class="bike-img">
        <img src="${bike.image}" alt="${bike.name}" loading="lazy"
          onerror="this.onerror=null;this.src='https://placehold.co/700x450/171d27/ffffff?text=Motorcycle'">
      </div>
      <div class="bike-info">
        <div class="category">${bike.category.toUpperCase()}</div>
        <h3>${bike.name}</h3>
        <div class="specs">
          <span>⚙ ${bike.engine}</span>
          <span>🏍 ${bike.type}</span>
        </div>
        <div class="price-row">
          <span class="price">${bike.price}</span>
          <button class="btn small-btn" onclick="enquire('${bike.name}')">Enquire ↗</button>
        </div>
      </div>
    </article>
  `).join("");

  document.getElementById("empty").style.display =
    results.length ? "none" : "block";
}

function enquire(name) {
  const phone = ""; // Apna WhatsApp number yahan likhein
  if (!phone) {
    alert("Please add your showroom WhatsApp number in the code first.");
    return;
  }
  const message = encodeURIComponent(
    "Assalam-o-Alaikum! I am interested in the " + name +
    ". Please share availability and current price."
  );
  window.open("https://wa.me/" + phone + "?text=" + message, "_blank");
}

search.addEventListener("input", renderBikes);
filter.addEventListener("change", renderBikes);
document.getElementById("year").textContent = new Date().getFullYear();

renderBikes();
</script>
</body>
</html>
